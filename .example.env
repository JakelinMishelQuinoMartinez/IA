# ============================================================
# .example.env — Copia este archivo a .env y rellena tus valores.
#   cp .example.env .env
# Luego ejecuta: node build-config.js  (genera config.local.js)
# ============================================================

# API Key de Google Gemini (obligatoria para usar el chatbot)
# Obtuéngela en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo por defecto del selector (debe coincidir con una opción del <select>)
DEFAULT_MODEL=gemini-2.5-flash

# Base URL de la API de Gemini (para futuras personalizaciones)
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta